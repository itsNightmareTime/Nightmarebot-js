{
	"env": {
		"node": true,
		"es2021": true
	},
	"extends": ["airbnb-base", "airbnb-base-typescript"],
	"plugins": ["@typescript-eslint"],
	"parser": "@typescript-eslint/parser",
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module",
		"project": "./tsconfig.json"
	},
	"ignorePatterns": ["dist/*"],
	"rules": {
		"no-plusplus": 0,
		"no-console": 0
	}
}